# Development-only Vault bootstrap token.
# Runtime secrets are seeded into Vault by docker/vault-init.sh.
VAULT_TOKEN=dev-only-root-token
VAULT_MOUNT_POINT=secret
VAULT_SECRET_PATH=maintainers-copilot

# Exposed ports
API_PORT=8000
MODEL_SERVER_PORT=8001
CHATBOT_PORT=8501
WIDGET_PORT=4173
DEMO_HOST_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
VAULT_PORT=8200
