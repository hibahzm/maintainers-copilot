# Development-only secret. Production secrets live in Vault.
VAULT_DEV_ROOT_TOKEN_ID=dev-only-root-token

# Exposed ports
API_PORT=8000
MODEL_SERVER_PORT=8001
CHATBOT_PORT=8501
WIDGET_PORT=4173
DEMO_HOST_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
VAULT_PORT=8200

# Saved Hugging Face classifier model directory for model-server /classify.
# Keep weights outside Git; mount/copy the Drive or MinIO artifact here when serving.
CLASSIFIER_MODEL_DIR=artifacts/classifier/first-distilbert-freeze4/model

# LLM summarizer model. API key must come from Vault/secrets, not this file.
OPENAI_SUMMARIZER_MODEL=gpt-4o-mini
